# Copy this file to .env and fill in your own values. Never commit .env.

# Neon connection string (use the dev branch while developing)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/skillmap?sslmode=require

# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# TheirStack: https://app.theirstack.com (Settings -> API Key). Free plan: 200 credits/month.
THEIRSTACK_API_KEY=
